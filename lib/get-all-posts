"use client";

import { motion } from "framer-motion";
import Link from "next/link";

type BlogSectionDictionary = {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  readMoreLabel?: string;
};

type BlogSectionProps = {
  locale: string;
  dictionary?: { blogSection?: BlogSectionDictionary };
  posts: BlogPost[]; // ✅ your existing BlogPost type
};

// ✨ Container + card animation variants (similar to ProjectsSection)
const containerVariants = {
  hidden: { opacity: 0, y: 24 },
  visible: {
    opacity: 1,
    y: 0,
    transition: {
      staggerChildren: 0.08,
      duration: 0.45,
      ease: "easeOut",
    },
  },
};

const cardVariants = {
  hidden: { opacity: 0, y: 18, scale: 0.96 },
  visible: {
    opacity: 1,
    y: 0,
    scale: 1,
    transition: {
      duration: 0.35,
      ease: "easeOut",
    },
  },
};

export default function BlogSection({
  locale,
  dictionary,
  posts,
}: BlogSectionProps) {
  const blogDict = dictionary?.blogSection ?? {};

  const title = blogDict.title ?? "From Our Blog";
  const subtitle =
    blogDict.subtitle ??
    "Explore stories, updates, and reflections from the Nouvo Ayiti 2075 movement.";

  const ctaLabel = blogDict.ctaLabel ?? "Visit Our Blog";
  const readMoreLabel = blogDict.readMoreLabel ?? "Read more →";

  // 🌐 Locale-aware blog URL (override with ctaHref in JSON if needed)
  const ctaHref =
    blogDict.ctaHref ?? `https://blogs.nouvoayiti2075.com/${locale}`;

  // Safety guard
  const postsToShow = Array.isArray(posts) ? posts : [];

  return (
    <section id="blog" className="bg-white py-16">
      <div className="max-w-6xl mx-auto px-4">
        {/* Heading */}
        <div className="text-center max-w-3xl mx-auto mb-10 space-y-3">
          <h2 className="text-3xl font-bold text-slate-900">{title}</h2>
          <p className="text-base text-slate-600">{subtitle}</p>
        </div>

        <div className="flex flex-col gap-8">
          {/* ✨ Animated grid of posts */}
          {postsToShow.length > 0 ? (
            <motion.div
              variants={containerVariants}
              initial="hidden"
              whileInView="visible"
              viewport={{ once: true, amount: 0.2 }}
              className="grid gap-6 sm:grid-cols-2 md:grid-cols-3 text-left"
            >
              {postsToShow.map((post, index) => (
                <motion.article
                  key={post.slug ?? index}
                  variants={cardVariants}
                  className="rounded-xl bg-slate-50 border border-slate-100 p-5
                             shadow-sm hover:shadow-lg hover:-translate-y-1
                             transition-transform transition-shadow duration-200"
                >
                  {/* If you have a BlogCard/BlogPreview component,
                      you can render it here instead of this inline layout */}
                  <Link
                    href={post.href ?? post.url ?? "#"}
                    className="flex flex-col gap-2 h-full"
                  >
                    {post.date && (
                      <p className="text-xs text-slate-500">{post.date}</p>
                    )}
                    <h3 className="font-semibold text-slate-900 leading-snug">
                      {post.title ?? "Blog post"}
                    </h3>
                    {post.excerpt && (
                      <p className="text-sm text-slate-600 line-clamp-3">
                        {post.excerpt}
                      </p>
                    )}
                    <span className="mt-auto pt-2 text-sm font-semibold text-red-600">
                      {readMoreLabel}
                    </span>
                  </Link>
                </motion.article>
              ))}
            </motion.div>
          ) : (
            <p className="text-center text-sm text-slate-500">
              Blog stories are coming soon. Stay tuned.
            </p>
          )}

          {/* CTA row */}
          <div className="flex justify-center">
            <Link
              href={ctaHref}
              className="inline-flex items-center justify-center rounded-full px-8 py-2.5
                         bg-slate-900 text-white text-sm font-semibold tracking-wide
                         shadow-sm hover:bg-slate-800 hover:shadow-lg hover:-translate-y-0.5
                         transition-transform transition-shadow duration-200
                         focus-visible:outline-none focus-visible:ring-2
                         focus-visible:ring-slate-900 focus-visible:ring-offset-2"
            >
              {ctaLabel}
            </Link>
          </div>
        </div>
      </div>
    </section>
  );
}
